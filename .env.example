DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
WEBHOOK_SECRET=your-webhook-secret-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=your-db-name-here
DB_USER=your-db-user-here
DB_PASS=your-db-password-here
DB_PORT=5432

# Leave empty for local dev (Celery tasks run inline).
CELERY_BROKER_URL=redis://redis:6379/0

# Redis backing the request throttles (shared across instances).
# Leave empty for local dev (falls back to in-process memory).
REDIS_THROTTLE_URL=redis://redis:6379/1

# Request throttle limits (DRF rate strings). Defaults shown; override per env.
# THROTTLE_RATE_ORG is per-organization across all its keys/tokens;
# the auth limits are per-IP on register/login.
THROTTLE_RATE_ORG=100/min
THROTTLE_RATE_REGISTER=5/min
THROTTLE_RATE_LOGIN=5/min

# Share of mock charges that are randomly declined (0.0-1.0).
# Leave 0 for deterministic local runs; docker-compose sets 0.5.
PAYMENT_FAILURE_RATE=0