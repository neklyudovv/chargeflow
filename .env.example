DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
WEBHOOK_SECRET=your-webhook-secret-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=your-db-name-here
DB_USER=your-db-user-here
